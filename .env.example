# PostgreSQL Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Authentication
FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk.json
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
# Optional: raw JSON string of service account (for cloud deployments)
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

# Squad Payment Gateway
SQUAD_SECRET_KEY=sandbox_sk_your_key_here
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_CALLBACK_URL=https://yourdomain.com/payment/payment_success

# CORS Allowed Origins (JSON list format)
# ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Celery & Redis ──────────────────────────────────────────
# For local development: use localhost
# For production: use cloud Redis (Upstash, Redis Cloud, etc.)
CELERY_BROKER_URL=redis://default:password@your-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://default:password@your-redis-host:6379/1

# Example: Upstash Redis (production-ready, free tier available)
# CELERY_BROKER_URL=redis://default:YOUR_PASSWORD@YOUR_ENDPOINT:6379/0
# CELERY_RESULT_BACKEND=redis://default:YOUR_PASSWORD@YOUR_ENDPOINT:6379/1

# ─── Email (SMTP) ────────────────────────────────────────────
# For local development: use Mailpit (http://localhost:1025 by default)
# For production: use Gmail, SendGrid, AWS SES, or your email provider
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM_ADDRESS=noreply@certverify.com
EMAIL_FROM_NAME=CertVerify

# Example: Gmail configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_USE_TLS=true

# ─── Admin Panel ──────────────────────────────────────────────
# JSON list of admin email addresses for bootstrap
ADMIN_EMAILS=["admin@certverify.com"]
ADMIN_SECRET_KEY=your_admin_secret_key_here_change_in_production

# ─── Frontend URL ────────────────────────────────────────────
# Used for generating links in emails (verification reports, password resets)
FRONTEND_URL=http://localhost:3000

